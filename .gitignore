# Asset policy (code-only repo, see ASSETS.md): game art/audio stay local.
# Whitelist: assets/fonts/ is SIL OFL licensed and redistributable;
# assets/effects/on_hit_flash.gdshader (+.uid) is project code.
/assets/*
!/assets/fonts/
!/assets/effects/
/assets/effects/*
!/assets/effects/on_hit_flash.gdshader
!/assets/effects/on_hit_flash.gdshader.uid
